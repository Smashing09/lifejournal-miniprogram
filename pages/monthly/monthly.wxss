.container {
  padding: 30rpx;
  min-height: 100vh;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #EC4899;
  background: #FFF0F5;
  border-radius: 50%;
}

.month-label {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A3F44;
}

.stats-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.stat-row {
  text-align: center;
  margin-bottom: 24rpx;
}

.stat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #EC4899;
}

.stat-label {
  font-size: 24rpx;
  color: #B5A9AD;
  margin-top: 4rpx;
}

.cat-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 2rpx solid #FFF0F5;
}

.cat-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.cat-stat-emoji {
  font-size: 40rpx;
}

.cat-stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3F44;
}

.generate-btn {
  background: linear-gradient(135deg, #EC4899, #F472B6);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  margin-bottom: 30rpx;
}

.generate-btn[disabled] {
  opacity: 0.6;
}

.report-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.report-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #FFF0F5;
}

.report-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3F44;
}

.report-body {
  padding: 8rpx 0;
}

.report-text {
  font-size: 28rpx;
  color: #4A3F44;
  line-height: 1.8;
  white-space: pre-wrap;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #B5A9AD;
  text-align: center;
}
