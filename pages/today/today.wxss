.container {
  padding: 24rpx;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 日期标题 - 紧凑 */
.date-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.date-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3F44;
}

.date-sub {
  display: block;
  font-size: 22rpx;
  color: #B5A9AD;
  margin-top: 6rpx;
}

/* 四大板块 2x2 网格 */
.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-card {
  width: calc(50% - 8rpx);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
  box-sizing: border-box;
}

.cat-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.cat-emoji {
  font-size: 34rpx;
}

.cat-label {
  font-size: 28rpx;
  font-weight: 600;
}

.cat-input {
  width: 100%;
  min-height: 80rpx;
  font-size: 26rpx;
  color: #4A3F44;
  line-height: 1.5;
}

/* 进度条 - 紧凑 */
.progress-bar {
  position: relative;
  height: 48rpx;
  background: #FFF0F5;
  border-radius: 24rpx;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #EC4899, #F9A8D4);
  border-radius: 24rpx;
  transition: width 0.3s;
}

.progress-text {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: #4A3F44;
  font-weight: 500;
}

/* 总结按钮 */
.summary-section {
  margin-top: 12rpx;
}

.summary-btn {
  background: linear-gradient(135deg, #EC4899, #F472B6);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
}

.summary-btn[disabled] {
  opacity: 0.6;
}

.no-key-tip {
  text-align: center;
  margin-top: 12rpx;
}

.no-key-tip text {
  font-size: 22rpx;
  color: #B5A9AD;
}

/* 总结弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #FFF0F5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3F44;
}

.modal-close {
  font-size: 36rpx;
  color: #B5A9AD;
  padding: 4rpx 12rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-summary-text {
  font-size: 30rpx;
  color: #4A3F44;
  line-height: 1.8;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
}

.modal-btn-copy {
  flex: 1;
  background: #FFF0F5;
  color: #EC4899;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 18rpx 0;
  line-height: 1.5;
}

.modal-btn-regen {
  flex: 1;
  background: linear-gradient(135deg, #EC4899, #F472B6);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 18rpx 0;
  line-height: 1.5;
}

.modal-btn-regen[disabled] {
  opacity: 0.6;
}
