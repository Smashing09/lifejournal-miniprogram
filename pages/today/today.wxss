.container {
  padding: 30rpx;
  min-height: 100vh;
}

.date-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.date-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3F44;
}

.date-sub {
  display: block;
  font-size: 24rpx;
  color: #B5A9AD;
  margin-top: 8rpx;
}

.categories {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-card {
  border-radius: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
}

.cat-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.cat-emoji {
  font-size: 40rpx;
}

.cat-label {
  font-size: 32rpx;
  font-weight: 600;
}

.cat-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #4A3F44;
  line-height: 1.6;
}

.progress-bar {
  position: relative;
  height: 60rpx;
  background: #FFF0F5;
  border-radius: 30rpx;
  margin: 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #EC4899, #F9A8D4);
  border-radius: 30rpx;
  transition: width 0.3s;
}

.progress-text {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: #4A3F44;
  font-weight: 500;
}

.summary-section {
  margin-top: 20rpx;
}

.summary-btn {
  background: linear-gradient(135deg, #EC4899, #F472B6);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.summary-btn[disabled] {
  opacity: 0.6;
}

.summary-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #FCE7F3;
  box-shadow: 0 4rpx 20rpx rgba(236, 72, 153, 0.08);
}

.summary-text {
  font-size: 30rpx;
  color: #4A3F44;
  line-height: 1.8;
}

.no-key-tip {
  text-align: center;
  margin-top: 16rpx;
}

.no-key-tip text {
  font-size: 24rpx;
  color: #B5A9AD;
}
