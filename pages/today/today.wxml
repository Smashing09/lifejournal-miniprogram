<view class="container">
  <!-- 日期标题 -->
  <view class="date-header">
    <text class="date-text">{{today}}</text>
    <text class="date-sub">记录每一个闪光的日子</text>
  </view>

  <!-- 四大板块 2x2 网格 -->
  <view class="categories">
    <view class="category-card" wx:for="{{categories}}" wx:key="key" style="background:{{item.bgColor}};">
      <view class="cat-header">
        <text class="cat-emoji">{{item.emoji}}</text>
        <text class="cat-label" style="color:{{item.color}};">{{item.label}}</text>
      </view>
      <textarea
        class="cat-input"
        placeholder="{{item.placeholder}}"
        placeholder-style="color:#C4B5B0;"
        value="{{inputs[item.key]}}"
        data-key="{{item.key}}"
        bindinput="onInput"
        maxlength="-1"
        auto-height
      />
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width:{{filledCount * 25}}%;" />
    <text class="progress-text">{{filledCount}}/4 已记录</text>
  </view>

  <!-- AI总结按钮 -->
  <view class="summary-section">
    <button class="summary-btn" bindtap="generateSummary" loading="{{summaryLoading}}" disabled="{{summaryLoading}}">
      {{summaryLoading ? '正在生成...' : '✨ 生成今日总结'}}
    </button>
    <view class="no-key-tip" wx:if="{{!hasApiKey}}">
      <text>💡 未配置API Key，将显示示例文案</text>
    </view>
  </view>
</view>

<!-- 总结弹窗 -->
<view class="modal-mask" wx:if="{{showSummaryModal}}" bindtap="closeModal">
  <view class="modal-content" catchtap="preventTouchMove">
    <view class="modal-header">
      <text class="modal-title">✨ 今日总结</text>
      <text class="modal-close" bindtap="closeModal">✕</text>
    </view>
    <view class="modal-body">
      <text class="modal-summary-text">{{summary}}</text>
    </view>
    <view class="modal-footer">
      <button class="modal-btn-copy" bindtap="copySummary">📋 复制</button>
      <button class="modal-btn-regen" bindtap="generateSummary" loading="{{summaryLoading}}">🔄 重新生成</button>
    </view>
  </view>
</view>
