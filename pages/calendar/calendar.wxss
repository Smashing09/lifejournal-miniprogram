.container {
  padding: 30rpx;
  min-height: 100vh;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #EC4899;
  background: #FFF0F5;
  border-radius: 50%;
}

.month-label {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A3F44;
}

.calendar {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.week-row {
  display: flex;
  margin-bottom: 16rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #B5A9AD;
  font-weight: 500;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-cell.empty {
  opacity: 0;
}

.day-num {
  font-size: 28rpx;
  color: #4A3F44;
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  background: #EC4899;
  border-radius: 50%;
  margin-top: 6rpx;
}

.detail-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.detail-header {
  margin-bottom: 24rpx;
}

.detail-date {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A3F44;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-cat {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cat-emoji {
  font-size: 28rpx;
  font-weight: 500;
  color: #4A3F44;
}

.cat-content {
  font-size: 26rpx;
  color: #6B5D62;
  line-height: 1.6;
}

.detail-summary {
  background: #FFF0F5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 8rpx;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: #EC4899;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #4A3F44;
  line-height: 1.6;
}

.no-record {
  text-align: center;
  padding: 40rpx 0;
}

.no-record text {
  font-size: 28rpx;
  color: #B5A9AD;
}
